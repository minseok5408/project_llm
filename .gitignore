# Secrets and local credentials — never commit
.env*
!.env.example
/.dev.vars*
!/.dev.vars.example
/.secrets/
/secrets/
/.npmrc
/.pypirc
/.netrc
*.pem
*.key
*.p12
*.pfx
*.jks
*credentials*.json
*service-account*.json
!*credentials*.example.json
!*service-account*.example.json

# Local models and Hugging Face caches — large files, keep outside Git
/.cache/
/.huggingface/
/models/
/model-cache/
/checkpoints/
/weights/
*.safetensors
*.gguf
*.ggml
*.ckpt
*.pt
*.pth
*.onnx
*.onnx_data
pytorch_model*.bin

