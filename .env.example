# 게이트웨이 제공자: "mlx"는 로컬 MLX-VLM 서버에 요청을 전달하고, "mock"은 모델 없이 동작합니다.
LLM_BACKEND=mlx
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_ID=mlx-community/Qwen3.8-27B-4bit

# 36 GB M3 Pro 환경에서는 컨텍스트 32K와 동시 요청 1건으로 시작합니다.
LLM_CONTEXT_WINDOW=32768
# 현재 DB당 실제 추론은 한 실행자만 처리합니다. 이 값을 늘려도 실행자 수는 늘지 않습니다.
LLM_MAX_CONCURRENT_GENERATIONS=1
LLM_REQUEST_TIMEOUT_SECONDS=900
LLM_MAX_HISTORY_CHARS=200000

# 입력과 요청 최대 출력이 문맥의 75%에 도달하면 오래된 대화를 요약합니다.
# 목표 비율은 시작 비율보다 작아야 하며, 요약 결과와 최근 대화를 더한 길이의 목표입니다.
LLM_COMPACTION_TRIGGER_RATIO=0.75
LLM_COMPACTION_TARGET_RATIO=0.55
# 최근 4쌍을 우선 원문으로 유지하며, 길이에 따라 최소 마지막 1쌍까지 조정합니다.
LLM_COMPACTION_KEEP_TURNS=4
# 요약 출력 상한입니다. 작은 문맥에서는 문맥 크기의 1/4 이하로 줄입니다.
# 요약 생성 사용량은 시스템 유지 기록에만 남고 사용자 토큰 한도에서 차감하지 않습니다.
LLM_COMPACTION_MAX_TOKENS=1024

# API 내장 실행자의 호환 옵션입니다. 기본값은 false이며 scripts/dev.py는 독립 worker를 실행합니다.
# 수동 실행은 python -m backend.app.worker를 사용합니다. API reload와 생성 수명이 분리됩니다.
GENERATION_WORKER_ENABLED=false
# 전체 queued/running 상한은 이 값 + 실행 슬롯 1개입니다. 사용자·대화별 active는 1개입니다.
GENERATION_QUEUE_LIMIT=3

# 웹검색은 기본 온라인 허용이며 키가 없거나 연결할 수 없으면 로컬 답변으로 전환합니다.
# 발급받은 Tavily API 키는 실제 .env에만 입력하고 출력·커밋하지 않습니다.
# 사용자별 로컬 전용 ON은 이 설정과 관계없이 외부 연결 검사와 검색을 막습니다.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# Tavily는 basic 검색만 사용하며 외부 답변 생성·원문 본문·이미지는 요청하지 않습니다.
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
# 외부에는 현재 질문의 앞부분만 보내며 이전 대화·요약·모델 입력은 보내지 않습니다.
WEB_SEARCH_MAX_QUERY_CHARS=500
WEB_SEARCH_MAX_CONTEXT_CHARS=12000
WEB_SEARCH_CHECK_CACHE_SECONDS=30
WEB_SEARCH_CHECK_TIMEOUT_SECONDS=2

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 웹 서버에서만 사용하는 FastAPI 주소입니다. 브라우저는 같은 웹 주소의 /api로 요청합니다.
API_BASE_URL=http://127.0.0.1:8000

# 로그인과 채팅에는 PostgreSQL이 필요합니다. 비활성 상태에서는 health와 인증 설정 조회만 가능합니다.
DATABASE_ENABLED=false
# 비활성화 시 비워 둡니다. 활성화 시 실제 계정으로 postgresql+asyncpg://user:password@127.0.0.1:5432/project_llm 형식의 주소를 입력합니다.
# URL은 SecretStr로 보관합니다. 실제 값을 채운 .env는 커밋하거나 내용을 출력하지 않습니다.
DATABASE_URL=
# 마이그레이션 소유자용 URL은 선택 사항이며, 비워 두면 DATABASE_URL을 사용합니다.
MIGRATION_DATABASE_URL=

# 애플리케이션 프로세스마다 기본 연결 5개와 최대 5개의 추가 연결을 허용합니다.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# 풀 대기, 연결 수립과 SELECT 1을 포함한 DB 준비 상태 검사 전체의 제한 시간입니다.
DATABASE_HEALTH_TIMEOUT_SECONDS=2

# 로컬 PostgreSQL 17 Compose 설정입니다. 127.0.0.1에만 바인딩합니다.
POSTGRES_DB=project_llm
POSTGRES_USER=system
POSTGRES_PORT=5432
# Compose 실행에 필요합니다. secrets.token_hex(24)로 생성한 값을 로컬 .env에만 입력합니다.
# DATABASE_URL에도 같은 비밀번호를 사용합니다. 자세한 절차는 run.md를 참고합니다.
POSTGRES_PASSWORD=

# 일반 회원가입 화면/API를 활성화합니다. 가입을 닫으려면 disabled로 변경합니다.
SIGNUP_MODE=open
# 현재 로컬·같은 Wi-Fi HTTP 접속용입니다. HTTPS를 준비한 뒤 true로 변경합니다.
AUTH_COOKIE_SECURE=false
