# Gateway provider: "mlx" proxies to the local MLX-VLM server; "mock" needs no model.
LLM_BACKEND=mlx
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_ID=mlx-community/Qwen3.8-27B-4bit

# The 36 GB M3 Pro profile starts conservatively at 32K context and one request.
LLM_CONTEXT_WINDOW=32768
LLM_MAX_CONCURRENT_GENERATIONS=1
LLM_REQUEST_TIMEOUT_SECONDS=900
LLM_MAX_HISTORY_CHARS=200000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
